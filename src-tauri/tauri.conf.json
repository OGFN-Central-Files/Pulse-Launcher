{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "8.0.1",
  "identifier": "Pulse",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pulse",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 750,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "shadow": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
